{
  "name": "fabulist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A state-first fiction engine: the prose is a view, the world is the graph underneath",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "play": "node --disable-warning=ExperimentalWarning src/cli/play.ts",
    "seed": "node --disable-warning=ExperimentalWarning src/cli/seed.ts",
    "backup": "node --disable-warning=ExperimentalWarning src/cli/backup.ts",
    "ingest": "node --disable-warning=ExperimentalWarning src/cli/ingest.ts",
    "integrity": "node --disable-warning=ExperimentalWarning src/cli/integrity.ts",
    "lint:prose": "node --disable-warning=ExperimentalWarning src/cli/lintprose.ts",
    "serve": "node --disable-warning=ExperimentalWarning src/cli/serve.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "script": "node --disable-warning=ExperimentalWarning src/cli/script.ts",
    "providers": "node --disable-warning=ExperimentalWarning src/cli/providers.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
