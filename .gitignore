node_modules/
dist/
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env.local

# Personal override of fabulist.config.json (and any --config= alternative),
# same *.local convention as .env.local above. The tracked config carries
# safe committed defaults (profile: "mock"); every runtime write — a profile
# switch, a kept provider spec — lands here instead, via config.ts's
# loadConfig/saveConfig, so the tracked file never drifts to one person's
# local setup.
*.config.local.json

data/
.cache/
coverage/
.DS_Store
*.log
.scratch/

# deploy/docker-compose.yml's default bind-mount target (FABULIST_DATA_DIR) —
# real world data if compose is ever run from within a repo checkout rather
# than a bare deploy directory on the VPS.
deploy/fabulist-data/

web/dist/

.dsh/

# The pnpm content-addressable store: ~2500 files and 69 MB of the working
# directory. It is a cache, it is machine-specific, and pnpm rebuilds it from
# the lockfile.
.pnpm-store/

# Design review frames. The written reviews in .design/*.md are the durable
# artefact and stay tracked; the screenshots are regenerated on every pass and
# were most of the repository's weight.
.design/*.png
.design/*.jpg
.design/*.webp

# Same reasoning one level down: .design/brand/*.svg are the icon drafts and are
# tracked, but the contact sheets and pixel tests are rebuilt by build.py.
.design/brand/render/
__pycache__/

# Local run artefacts (server logs, detached-process scratch).
.run/
.worktrees/
